# DevsAssemble — environment variables
# Copy to .env.local and fill in. This file IS committed, so it must contain
# ONLY placeholders — never real secrets. Real values (secret key, DB password,
# API keys) go ONLY in .env.local, which is git-ignored.

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3005   # prod: https://devsassemble.ai

# --- Supabase (use a DEDICATED DevsAssemble project) ---
# New-format API keys — NOT the legacy JWT anon/service_role keys.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx   # publishable = safe to ship client-side
SUPABASE_SECRET_KEY=sb_secret_xxx                         # SECRET — .env.local only, bypasses RLS
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres  # SECRET — .env.local only

# --- Resend (transactional email + Supabase Auth SMTP) ---
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=hello@devsassemble.ai
RESEND_WEBHOOK_SECRET=whsec_xxx

# --- GitHub OAuth (also configure in Supabase Auth → Providers → GitHub) ---
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- Restream ---
NEXT_PUBLIC_RESTREAM_EMBED_BASE=https://player.restream.io

# --- OpenTelemetry (Vercel now; retarget later, env-only) ---
OTEL_SERVICE_NAME=devsassemble

# --- Platform ---
CRON_SECRET=                                 # protects /api/cron/* routes
